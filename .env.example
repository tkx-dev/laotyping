# LaoType Environment Configuration for SEO & Google Search Console

# Production Site URL (used for canonical URLs, sitemaps, Open Graph images)
NUXT_PUBLIC_SITE_URL=https://typing.nungdees.xyz

# Google Search Console Verification Meta Tag Content (Optional if already auto-verified via Domain property)
# e.g., if Google gives you: <meta name="google-site-verification" content="abcdef1234567890" />
# Set only the content token value:
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
